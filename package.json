{
  "name": "credencia",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "tsx --test tests/*.test.ts",
    "db:migrate": "tsx server/migrate.ts",
    "seed": "tsx server/seed.ts",
    "admin": "tsx server/admin.ts",
    "privacy:purge": "tsx server/purge.ts",
    "dev:client": "vite",
    "dev:server": "tsx watch server/index.ts",
    "test:postgres": "tsx scripts/test-postgres.ts",
    "test:ui": "tsx --test tests/ui.test.ts",
    "format": "prettier --write src server tests scripts *.json *.ts index.html"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "zod": "^4.0.17",
    "tsx": "^4.20.4"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.17.1",
    "@types/nodemailer": "^6.4.17",
    "@types/pg": "^8.15.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.9",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "embedded-postgres": "^18.6.0-beta.19",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.1.4",
    "typescript": "^5.9.2",
    "vite": "^6.1.0"
  }
