# Desenvolvimento local. Sem DATABASE_URL usa PostgreSQL embarcado persistente em ./data.
APP_ORIGIN=http://localhost:3000
PORT=3000
NODE_ENV=development
DATA_DIR=./data
# PostgreSQL convencional (obrigatório em produção):
# DATABASE_URL=postgresql://credencia:senha@localhost:5432/credencia
# SMTP de desenvolvimento pode ser o Mailpit da composição Docker:
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
MAIL_FROM=Credencia <nao-responda@localhost>
# Ative apenas atrás de UM proxy reverso confiável:
TRUST_PROXY=0
# Defina somente depois da política institucional de retenção:
# LOCATION_RETENTION_DAYS=30
# Docker: copie .env.example para .env e defina uma senha local forte:
# POSTGRES_PASSWORD=
